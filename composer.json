{
    "name": "rappasoft/laravel-livewire-tables",
    "description": "A dynamic table component for Laravel Livewire",
    "keywords": [
        "rappasoft",
        "livewire",
        "datatables",
        "tables",
        "laravel"
    ],
    "homepage": "https://github.com/rappasoft/laravel-livewire-tables",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Rappa",
            "email": "rappa819@gmail.com",
            "role": "Developer"
        },
        {
            "name": "Joe McElwee",
            "email": "joe@lowerrocklabs.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "blade-ui-kit/blade-heroicons": "^2.1",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "ext-sqlite3": "*",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.10",
        "livewire/flux": "^2.15",
        "monolog/monolog": "*",
        "nunomaduro/collision": "^8.0|^9.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rappasoft\\LaravelLivewireTables\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rappasoft\\LaravelLivewireTables\\Tests\\": "tests",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "test-parallel": "vendor/bin/pest --parallel",
        "format": "vendor/bin/pint",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "npx --yes concurrently --kill-others --names 'app,vite' -c 'blue,magenta' \"php vendor/bin/testbench serve --port=8000 --ansi\" \"npm run dev\""
        ],
        "serve-only": "@php vendor/bin/testbench serve --ansi"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rappasoft\\LaravelLivewireTables\\LaravelLivewireTablesServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
